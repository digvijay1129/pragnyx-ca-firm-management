    {
      "name": "Authentication",
      "item": [
        {
          "0": {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Client registration returns 201', () => pm.response.to.have.status(201));",
                "const data = pm.response.json();",
                "pm.collectionVariables.set('clientToken', data.token);",
                "pm.collectionVariables.set('clientId', data.user.id);"
              ]
            }
          },
          "name": "Register client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{clientName}}\",\n  \"email\": \"{{clientEmail}}\",\n  \"phone\": \"{{clientPhone}}\",\n  \"password\": \"{{clientPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "0": {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Client login returns 200', () => pm.response.to.have.status(200));",
                "pm.collectionVariables.set('clientToken', pm.response.json().token);"
              ]
            }
          },
          "name": "Login client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{clientPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "0": {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Admin login returns 200', () => pm.response.to.have.status(200));",
                "pm.collectionVariables.set('adminToken', pm.response.json().token);"
              ]
            }
          },
          "name": "Login administrator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/auth/me"
            }
          }
        },
        {
          "name": "Update client profile",
