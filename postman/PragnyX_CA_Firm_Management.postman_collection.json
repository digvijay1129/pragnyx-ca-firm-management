  "info": {
    "_postman_id": "7f8fa3ec-8475-4d23-b3d2-7a8c12a0f015",
    "name": "PragnyX CA Firm Management API",
    "description": "Postman collection mapped to the PragnyX MERN assignment. Start the Express API and MongoDB first. Register a client and seed an administrator using private environment variables. Set preferredDate to a future YYYY-MM-DD date and selectedService to an active service name. Do not use the test database or sample passwords for production.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health & Public Services",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/../health"
            }
          }
        },
        {
          "name": "List active services",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/services"
            }
          }
        },
        {
          "name": "Get a service by slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/services/{{serviceSlug}}"
            }
          }
        }
      ]
